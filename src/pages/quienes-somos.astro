---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
---

<Layout title="Quienes Somos - UCB Cristo al Mundo">
  <Header />

  <main
    class="snap-y snap-mandatory h-screen overflow-y-scroll snap-scroll-thumb"
  >
    <section
      id="inicio"
      class="snap-start min-h-screen relative flex items-center justify-center pt-16 bg-paper"
    >
      <div class="flex flex-col items-center justify-center text-center px-6">
        <p class="label-mono mb-4">Iglesia</p>
        <h1 class="text-section text-ink mb-4">Quiénes Somos</h1>
        <p class="text-body-large font-[320]">Próximamente...</p>
      </div>
    </section>
    <Footer />
  </main>
</Layout>
