---
export const prerender = true;

import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import Horarios from "../components/Horarios.astro";
import Predicas from "../components/Predicas.astro";
import Contacto from "../components/Contacto.astro";
import Footer from "../components/Footer.astro";
---

<Layout
  title="UCB Cristo al Mundo | Iglesia en Melipilla"
  description="Iglesia UCB Cristo al Mundo en Melipilla: participa en nuestros cultos, conoce nuestros horarios y encuentra cómo contactarnos."
>
  <Header />

  <main
    class="md:snap-y md:snap-mandatory h-screen overflow-y-scroll snap-scroll-thumb"
  >
    <Hero />
    <Horarios />
    <Predicas />
    <Contacto />
    <Footer />
  </main>
</Layout>
