---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
---

<Layout
  title="Organigrama | UCB Cristo al Mundo"
  description="Información organizacional interna de UCB Cristo al Mundo."
  noindex
>
  <Header />

  <main class="h-screen overflow-y-scroll bg-paper pt-24 snap-scroll-thumb">
    <div
      class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 min-h-screen flex flex-col pb-12"
    >
      <div class="text-center mb-16">
        <p class="label-mono mb-4">Liderazgo</p>
        <h1 class="text-section text-ink mb-4">Organigrama de la Iglesia</h1>
        <p class="text-body-large font-[320] max-w-2xl mx-auto">
          Jerarquía, liderazgo y servidores de nuestra congregación
        </p>
      </div>

      <div class="grow flex flex-col items-center space-y-10 relative w-full">
        <!-- 1. Pastor Asesor -->
        <div class="w-full flex justify-center">
          <div
            class="bg-paper shadow-sm rounded-[8px] p-6 border-t-2 border-ink w-full max-w-sm text-center transform transition duration-300 hover:-translate-y-1 hover:shadow-md"
          >
            <span class="label-mono-sm text-ink mb-2 block">Pastor Asesor</span>
            <h2 class="text-2xl font-[700] text-ink">Hernán Contreras</h2>
          </div>
        </div>

        <!-- 2. Ancianos -->
        <div
          class="w-full flex flex-col md:flex-row justify-center items-center gap-6"
        >
          <div
            class="bg-paper shadow-sm rounded-[8px] p-6 border-t-2 border-ink w-full max-w-xs text-center transform transition duration-300 hover:-translate-y-1 hover:shadow-md"
          >
            <span class="label-mono-sm text-ink mb-2 block">Anciano</span>
            <h3 class="text-xl font-[700] text-ink">Carlos Liempi</h3>
          </div>
          <div
            class="bg-paper shadow-sm rounded-[8px] p-6 border-t-2 border-ink w-full max-w-xs text-center transform transition duration-300 hover:-translate-y-1 hover:shadow-md"
          >
            <span class="label-mono-sm text-ink mb-2 block">Anciano</span>
            <h3 class="text-xl font-[700] text-ink">Jonathan Palma</h3>
          </div>
        </div>

        <!-- 3. Tesorero y Secretaria -->
        <div
          class="w-full flex flex-col md:flex-row justify-center items-center gap-6"
        >
          <div
            class="bg-paper shadow-sm rounded-[8px] p-5 border-t-2 border-ink w-full max-w-xs text-center transform transition duration-300 hover:-translate-y-1 hover:shadow-md"
          >
            <span class="label-mono-sm text-ink mb-1 block">Tesorero</span>
            <h3 class="text-lg font-[700] text-ink">Ricardo Fuentes</h3>
          </div>
          <div
            class="bg-paper shadow-sm rounded-[8px] p-5 border-t-2 border-ink w-full max-w-xs text-center transform transition duration-300 hover:-translate-y-1 hover:shadow-md"
          >
            <span class="label-mono-sm text-ink mb-1 block">Secretaria</span>
            <h3 class="text-lg font-[700] text-ink">Nicole Herrera</h3>
          </div>
        </div>

        <!-- 4. Diáconos, Diaconisas y Ministerios -->
        <div class="w-full grid grid-cols-1 md:grid-cols-3 gap-8 mt-6">
          <!-- Diáconos -->
          <div
            class="bg-paper shadow-sm rounded-[8px] overflow-hidden ring-1 ring-ink/10 transform transition duration-300 hover:-translate-y-1 hover:shadow-md flex flex-col"
          >
            <div class="bg-ink px-6 py-4">
              <h3 class="label-mono-sm text-paper text-center">Diáconos</h3>
            </div>
            <ul class="divide-y divide-ink/10 px-6 py-2 grow">
              <li class="py-3 text-ink font-[340] text-center">
                Ricardo Fuentes
              </li>
              <li class="py-3 text-ink font-[340] text-center">Juan Iturra</li>
              <li class="py-3 text-ink font-[340] text-center">Víctor Jofré</li>
              <li class="py-3 text-ink font-[340] text-center">Carlos Dunarri</li>
              <li class="py-3 text-ink font-[340] text-center">
                Alejandro Alvarado
              </li>
              <li class="py-3 text-ink font-[340] text-center">
                Christopher Rojas
              </li>
              <li class="py-3 text-ink font-[340] text-center">Pablo García</li>
            </ul>
          </div>

          <!-- Diaconisas -->
          <div
            class="bg-paper shadow-sm rounded-[8px] overflow-hidden ring-1 ring-ink/10 transform transition duration-300 hover:-translate-y-1 hover:shadow-md flex flex-col"
          >
            <div class="bg-ink px-6 py-4">
              <h3 class="label-mono-sm text-paper text-center">Diaconisas</h3>
            </div>
            <ul class="divide-y divide-ink/10 px-6 py-2 grow">
              <li class="py-3 text-ink font-[340] text-center">
                Carolina Vargas
              </li>
              <li class="py-3 text-ink font-[340] text-center">Mylene Pérez</li>
              <li class="py-3 text-ink font-[340] text-center">
                Tamara Santander
              </li>
              <li class="py-3 text-ink font-[340] text-center">
                Paula Maldonado
              </li>
              <li class="py-3 text-ink font-[340] text-center">Jocelyn Ayenao</li>
              <li class="py-3 text-ink font-[340] text-center">Rosa Muñoz</li>
              <li class="py-3 text-ink font-[340] text-center">
                Victoria Torres
              </li>
              <li class="py-3 text-ink font-[340] text-center">
                Damaridt Torres
              </li>
            </ul>
          </div>

          <!-- Ministerios -->
          <div
            class="bg-paper shadow-sm rounded-[8px] overflow-hidden ring-1 ring-ink/10 transform transition duration-300 hover:-translate-y-1 hover:shadow-md flex flex-col"
          >
            <div class="bg-ink px-6 py-4">
              <h3 class="label-mono-sm text-paper text-center">
                Líderes de Ministerios
              </h3>
            </div>
            <ul class="divide-y divide-ink/10 px-6 py-2 grow">
              <li class="py-3 flex flex-col items-center text-center">
                <span class="label-mono-sm text-ink mb-1">Jóvenes (JPC)</span>
                <span class="text-ink font-[340]">Juan Iturra</span>
              </li>
              <li class="py-3 flex flex-col items-center text-center">
                <span class="label-mono-sm text-ink mb-1">Alabanza</span>
                <span class="text-ink font-[340]">Cristopher Rojas</span>
              </li>
              <li class="py-3 flex flex-col items-center text-center">
                <span class="label-mono-sm text-ink mb-1"
                  >Audiovisual (Alabanza)</span
                >
                <span class="text-ink font-[340]">Ricardo Fuentes</span>
              </li>
              <li class="py-3 flex flex-col items-center text-center">
                <span class="label-mono-sm text-ink mb-1">Escuela Dominical</span>
                <span class="text-ink font-[340]"
                  >Paula Vivar y Paula Maldonado</span
                >
              </li>
              <li class="py-3 flex flex-col items-center text-center">
                <span class="label-mono-sm text-ink mb-1">Diaconado</span>
                <span class="text-ink font-[340]"
                  >Ricardo Fuentes y Carola Vargas</span
                >
              </li>
              <li class="py-3 flex flex-col items-center text-center">
                <span class="label-mono-sm text-ink mb-1">Damas</span>
                <span class="text-ink font-[340]"
                  >Carola Vargas, Eva Meza y Victoria Torres</span
                >
              </li>
            </ul>
          </div>
        </div>
      </div>
    </div>

    <Footer />
  </main>
</Layout>
