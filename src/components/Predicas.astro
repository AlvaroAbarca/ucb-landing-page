---
import dayjs from "dayjs";
import "dayjs/locale/es";
import localizedFormat from "dayjs/plugin/localizedFormat";
dayjs.extend(localizedFormat);

import { type YoutubeVideo } from "../types/youtube.types";
import data from "../data/predicas.json" with { type: "json" };

const predicas: YoutubeVideo[] = data;
---

<section
  id="predicas"
  class="snap-start min-h-screen flex flex-col justify-start bg-glass-dark pt-24 pb-16"
>
  <div class="container mx-auto px-6">
    <div
      class="flex flex-col md:flex-row justify-between items-end mb-12 max-w-6xl mx-auto"
    >
      <div>
        <p class="label-mono mb-4">Contenido</p>
        <h2 class="text-section text-ink mb-4">Últimas Prédicas</h2>
        <p class="text-body-large text-ink max-w-xl font-[320]">
          Aliméntate de la Palabra de Dios a través de nuestros estudios y
          sermones recientes.
        </p>
      </div>
      <a
        href="https://www.youtube.com/@iglesiaucbcristoalmundo"
        target="_blank"
        rel="noopener noreferrer"
        class="hidden md:flex items-center text-ink font-[450] hover:underline underline-offset-4 decoration-1 transition-colors"
      >
        Ver canal completo
        <svg
          class="w-5 h-5 ml-2"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="1.5"
            d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
        </svg>
      </a>
    </div>

    <div
      class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 max-w-6xl mx-auto"
    >
      {
        predicas.slice(0, 3).map((predica) => (
          <div class="bg-paper rounded-[8px] overflow-hidden ring-1 ring-ink/10 hover:shadow-md transition-all flex flex-col group">
            <div class="relative h-60 overflow-hidden">
              <img
                src={predica.thumbnail}
                alt={predica.title}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              />
              <div class="absolute inset-0 bg-ink/10 group-hover:bg-transparent transition-colors duration-500" />
              <div class="absolute inset-0 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity duration-300">
                <a
                  href={`https://www.youtube.com/watch?v=${predica.videoId}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="bg-ink text-paper w-14 h-14 rounded-full flex items-center justify-center hover:scale-110 shadow-lg transition-all"
                  aria-label={`Reproducir: ${predica.title}`}
                >
                  <svg class="w-8 h-8" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M8 5v14l11-7z" />
                  </svg>
                </a>
              </div>
            </div>
            <div class="p-6 flex-1 flex flex-col">
              <div class="label-mono-sm text-ink mb-3">
                <span>
                  {dayjs(predica.publishedAt).locale("es").format("LL")}
                </span>
              </div>
              <h3 class="text-xl font-bold text-ink mb-2">{predica.title}</h3>
              <p class="text-ink font-[320] mt-auto flex items-center tracking-[-0.14px]">
                <svg
                  class="w-4 h-4 mr-2"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="1.5"
                    d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"
                  />
                </svg>
                {predica.preacher}
              </p>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
