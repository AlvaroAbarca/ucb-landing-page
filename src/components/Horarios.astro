---
const reuniones = [
  {
    titulo: "Culto de Adoración Dominical",
    dia: "Domingo",
    hora: "10:30",
    descripcion:
      "Nuestro servicio principal de alabanza y predicación de la Palabra.",
  },
  {
    titulo: "Escuela Dominical",
    dia: "Domingo",
    hora: "10:30",
    descripcion:
      "Clases bíblicas para todas las edades antes del culto principal.",
  },
  {
    titulo: "Reunión de Oración",
    dia: "Miércoles",
    hora: "20:30",
    descripcion:
      "Un tiempo dedicado a buscar la presencia de Dios en comunión.",
  },
  {
    titulo: "Grupo de Jóvenes",
    dia: "Sábado",
    hora: "18:00",
    descripcion: "Reunión dinámica para adolescentes y jóvenes.",
  },
];
---
<section
  id="horarios"
  class="snap-start min-h-screen flex items-center bg-paper pt-20 pb-12"
>
  <div class="container mx-auto px-6">
    <div class="text-center mb-16">
      <p class="label-mono mb-4">Agenda</p>
      <h2 class="text-section text-ink mb-4">Nuestros Horarios</h2>
      <p class="text-body-large text-ink max-w-2xl mx-auto font-[320]">
        Te invitamos a ser parte de nuestras actividades semanales. Hay un
        lugar para ti en nuestra congregación.
      </p>
    </div>

    <div
      class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8 max-w-6xl mx-auto"
    >
      {
        reuniones.map((reunion) => (
          <div class="bg-paper p-8 rounded-[8px] ring-1 ring-ink/10 hover:shadow-md transition-all group">
            <div class="w-14 h-14 bg-glass-dark text-ink rounded-full flex items-center justify-center mb-6 group-hover:scale-105 transition-transform">
              <svg
                class="w-7 h-7"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                xmlns="http://www.w3.org/2000/svg"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="1.5"
                  d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"
                />
              </svg>
            </div>
            <h3 class="text-xl font-[700] text-ink mb-2 tracking-normal">
              {reunion.titulo}
            </h3>
            <div class="flex items-center text-ink font-[450] mb-4 space-x-2">
              <span>{reunion.dia}</span>
              <span class="w-1.5 h-1.5 rounded-full bg-ink" />
              <span>{reunion.hora}</span>
            </div>
            <p class="text-ink font-[320] leading-relaxed tracking-[-0.14px]">
              {reunion.descripcion}
            </p>
          </div>
        ))
      }
    </div>
  </div>
</section>
