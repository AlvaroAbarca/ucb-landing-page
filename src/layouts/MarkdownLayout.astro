---
import Layout from "./Layout.astro";

interface Props {
  frontmatter: {
    title: string;
    description?: string;
  };
}

const { frontmatter } = Astro.props;
---

<Layout title={frontmatter.title}>
  <main
    class="min-h-screen py-12 px-4 sm:px-6 lg:px-8 bg-paper flex justify-center"
  >
    <article
      class="prose prose-neutral prose-headings:font-[400] prose-headings:tracking-tight prose-a:text-ink prose-a:underline prose-a:decoration-1 hover:prose-a:opacity-70 lg:prose-lg mx-auto bg-paper p-8 md:p-16 ring-1 ring-ink/10 rounded-[8px] w-full max-w-4xl"
    >
      <div class="not-prose mb-12">
        <a
          href="/"
          onclick="if (window.history.length > 1 && document.referrer.includes(window.location.host)) { event.preventDefault(); window.history.back(); }"
          class="text-ink/70 hover:text-ink transition-colors inline-flex items-center gap-2 text-sm font-[340]"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="lucide lucide-arrow-left"
          >
            <path d="m12 19-7-7 7-7"></path>
            <path d="M19 12H5"></path>
          </svg>
          Volver atrás
        </a>
      </div>
      <slot />
    </article>
  </main>
</Layout>
